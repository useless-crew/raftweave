# Server
PORT=8080
ENVIRONMENT=development

# Database
DATABASE_URL=postgres://raftweave:raftweave_dev_password@localhost:5432/raftweave_auth?sslmode=disable

# Redis
REDIS_URL=redis://:raftweave_redis_password@localhost:6379/0

# JWT — GENERATE REAL SECRETS, DO NOT USE THESE IN PRODUCTION
# To generate: openssl rand -base64 64
JWT_ACCESS_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_64
JWT_REFRESH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_64_different_value

# JWT Expiry
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# CORS — Vite dev server
ALLOWED_ORIGINS=http://localhost:5173

# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=30
RATE_LIMIT_BURST=10

# Account lockout
MAX_FAILED_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Frontend base URL — used to build the post-OAuth redirect URL
FRONTEND_URL=http://localhost:5173

# OAuth — GitHub
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: http://localhost:8080/auth/github/callback
GITHUB_CLIENT_ID=CHANGE_ME
GITHUB_CLIENT_SECRET=CHANGE_ME
GITHUB_REDIRECT_URL=http://localhost:8080/auth/github/callback

# OAuth — Google
# Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8080/auth/google/callback
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# OAuth provider token encryption key — 64 hex chars (32 bytes), used to
# derive an AES-256-GCM key (via HKDF) for encrypting provider access/refresh
# tokens at rest. Generate with: openssl rand -hex 32
OAUTH_TOKEN_ENCRYPTION_KEY=CHANGE_ME_64_char_hex_string
